{
  "functions": {
    "api/agents.js": { "includeFiles": "{404.html,index.html,contacto.html,about.html,privacy.html,js/catalog-data.js,js/products-data.js}" }
  },
  "rewrites": [
    { "source": "/about", "destination": "/about.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/mcp", "destination": "/api/agents?route=mcp" },
    { "source": "/mcp/server-card", "destination": "/api/agents?route=server-card" },
    { "source": "/.well-known/mcp", "destination": "/api/agents?route=server-card" },
    {
      "source": "/:path*",
      "has": [{ "type": "header", "key": "accept", "value": ".*text/markdown.*" }],
      "destination": "/api/agents?route=not-found"
    }
  ],
  "headers": [
    {
      "source": "/(about|privacy)?(\\.html)?",
      "headers": [{ "key": "Vary", "value": "Accept" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()" }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/((?!fonts/).*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/(css|js)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    }
  ]
}
